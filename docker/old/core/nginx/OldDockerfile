# Gunakan image nginx resmi yang ringan
FROM nginx:1.27-alpine

# Hapus default config agar tidak bentrok
RUN rm /etc/nginx/conf.d/default.conf

# Copy custom konfigurasi
COPY ./docker/nginx/default.conf /etc/nginx/conf.d/default.conf

# Copy build hasil dari Laravel (opsional kalau ingin include langsung)
# COPY ./src/public /var/www/html/public

# Buat folder log agar tidak error permission
RUN mkdir -p /var/log/nginx && chmod -R 755 /var/log/nginx

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]

